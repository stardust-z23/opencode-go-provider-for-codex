{
	"name": "opencode-go-provider-for-codex",
	"publisher": "stardust-z23",
	"displayName": "%displayName%",
	"description": "%description%",
	"icon": "resources/extension-icon.png",
	"keywords": [
		"ai",
		"codex",
		"opencode",
		"opencode-go",
		"model-picker",
		"config",
		"toml",
		"openai-compatible"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/stardust-z23/opencode-go-provider-for-codex"
	},
	"version": "0.2.19",
	"engines": {
		"vscode": "^1.116.0"
	},
	"categories": [
		"AI",
		"Other"
	],
	"license": "MIT",
	"activationEvents": [
		"onStartupFinished"
	],
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": false,
			"description": "This extension reads and writes the Codex configuration file (config.toml) in your user home directory, and stores an API key in VS Code SecretStorage."
		}
	},
	"contributes": {
		"commands": [
			{
				"command": "codexgo.syncModelCatalog",
				"category": "%commandCategory%",
				"title": "%command.syncModelCatalog%",
				"icon": "$(cloud-download)"
			},
			{
				"command": "codexgo.removeModelCatalog",
				"category": "%commandCategory%",
				"title": "%command.removeModelCatalog%",
				"icon": "$(discard)"
			},
			{
				"command": "codexgo.setApiKey",
				"category": "%commandCategory%",
				"title": "%command.setApiKey%"
			},
			{
				"command": "codexgo.getApiKey",
				"category": "%commandCategory%",
				"title": "%command.getApiKey%"
			},
			{
				"command": "codexgo.checkUsage",
				"category": "%commandCategory%",
				"title": "%command.checkUsage%",
				"icon": "$(pulse)"
			},
			{
				"command": "codexgo.openUsageDashboard",
				"category": "%commandCategory%",
				"title": "%command.openUsageDashboard%",
				"icon": "$(graph)"
			},
			{
				"command": "codexgo.openModelCenter",
				"category": "%commandCategory%",
				"title": "%command.openModelCenter%",
				"icon": "$(library)"
			},
			{
				"command": "codexgo.openCodexConfig",
				"category": "%commandCategory%",
				"title": "%command.openCodexConfig%",
				"icon": "$(file-code)"
			},
			{
				"command": "codexgo.openSettings",
				"category": "%commandCategory%",
				"title": "%command.openSettings%"
			},
			{
				"command": "codexgo.configureClaudeCode",
				"category": "%commandCategory%",
				"title": "%command.configureClaudeCode%",
				"icon": "$(plug)"
			},
			{
				"command": "codexgo.refreshClaudeCodePicker",
				"category": "%commandCategory%",
				"title": "%command.refreshClaudeCodePicker%",
				"icon": "$(refresh)"
			},
			{
				"command": "codexgo.restoreClaudeCode",
				"category": "%commandCategory%",
				"title": "%command.restoreClaudeCode%",
				"icon": "$(discard)"
			},
			{
				"command": "codexgo.showClaudeCodeDiagnostics",
				"category": "%commandCategory%",
				"title": "%command.showClaudeCodeDiagnostics%",
				"icon": "$(output)"
			}
		],
		"walkthroughs": [
			{
				"id": "codexGoGettingStarted",
				"title": "%walkthrough.title%",
				"description": "%walkthrough.description%",
				"steps": [
					{
						"id": "setApiKey",
						"title": "%walkthrough.setApiKey.title%",
						"description": "%walkthrough.setApiKey.description%",
						"media": {
							"markdown": "resources/walkthrough/set-api-key.md"
						},
						"completionEvents": [
							"onCommand:codexgo.setApiKey"
						]
					},
					{
						"id": "syncModels",
						"title": "%walkthrough.syncModels.title%",
						"description": "%walkthrough.syncModels.description%",
						"media": {
							"markdown": "resources/walkthrough/sync-models.md"
						},
						"completionEvents": [
							"onCommand:codexgo.syncModelCatalog"
						]
					},
					{
						"id": "configureClaudeCode",
						"title": "%walkthrough.configureClaudeCode.title%",
						"description": "%walkthrough.configureClaudeCode.description%",
						"media": {
							"markdown": "resources/walkthrough/configure-claude-code.md"
						},
						"completionEvents": [
							"onCommand:codexgo.configureClaudeCode"
						]
					}
				]
			}
		],
		"configuration": {
			"title": "%config.title%",
			"properties": {
				"codexgo.codexHome": {
					"type": "string",
					"default": "",
					"markdownDescription": "%config.codexHome.desc%"
				},
				"codexgo.codexExecutable": {
					"type": "string",
					"default": "",
					"markdownDescription": "%config.codexExecutable.desc%"
				},
				"codexgo.maxBackups": {
					"type": "number",
					"default": 5,
					"minimum": 1,
					"maximum": 50,
					"markdownDescription": "%config.maxBackups.desc%"
				},
				"codexgo.showUsage": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%config.showUsage.desc%"
				},
				"codexgo.usageRefreshInterval": {
					"type": "number",
					"default": 5,
					"minimum": 1,
					"maximum": 60,
					"markdownDescription": "%config.usageRefreshInterval.desc%"
				},
				"codexgo.usageDisplayWindow": {
					"type": "string",
					"enum": [
						"rolling",
						"weekly",
						"monthly"
					],
					"enumDescriptions": [
						"%config.usageDisplayWindow.rolling.desc%",
						"%config.usageDisplayWindow.weekly.desc%",
						"%config.usageDisplayWindow.monthly.desc%"
					],
					"default": "rolling",
					"markdownDescription": "%config.usageDisplayWindow.desc%"
				},
				"codexgo.usageWarningThreshold": {
					"type": "number",
					"default": 80,
					"minimum": 0,
					"maximum": 100,
					"markdownDescription": "%config.usageWarningThreshold.desc%"
				},
				"codexgo.usageErrorThreshold": {
					"type": "number",
					"default": 95,
					"minimum": 0,
					"maximum": 100,
					"markdownDescription": "%config.usageErrorThreshold.desc%"
				},
				"codexgo.proxyPort": {
					"type": "number",
					"default": 15722,
					"minimum": 1024,
					"maximum": 65535,
					"markdownDescription": "%config.proxyPort.desc%"
				},
				"codexgo.claudeCode.defaultModel": {
					"type": "string",
					"default": "",
					"markdownDescription": "%config.claudeCode.defaultModel.desc%"
				},
				"codexgo.claudeCode.opusModel": {
					"type": "string",
					"default": "",
					"markdownDescription": "%config.claudeCode.opusModel.desc%"
				},
				"codexgo.claudeCode.sonnetModel": {
					"type": "string",
					"default": "",
					"markdownDescription": "%config.claudeCode.sonnetModel.desc%"
				},
				"codexgo.claudeCode.haikuModel": {
					"type": "string",
					"default": "",
					"markdownDescription": "%config.claudeCode.haikuModel.desc%"
				},
				"codexgo.claudeCode.fableModel": {
					"type": "string",
					"default": "",
					"markdownDescription": "%config.claudeCode.fableModel.desc%"
				},
				"codexgo.claudeCode.subagentModel": {
					"type": "string",
					"default": "",
					"markdownDescription": "%config.claudeCode.subagentModel.desc%"
				},
				"codexgo.claudeCode.settingsPath": {
					"type": "string",
					"default": "",
					"markdownDescription": "%config.claudeCode.settingsPath.desc%"
				},
				"codexgo.claudeCode.executable": {
					"type": "string",
					"default": "",
					"markdownDescription": "%config.claudeCode.executable.desc%"
				},
				"codexgo.claudeCode.replaceBuiltInPicker": {
					"type": "boolean",
					"default": true,
					"markdownDescription": "%config.claudeCode.replaceBuiltInPicker.desc%"
				},
				"codexgo.claudeCode.useBehavesAs": {
					"type": "boolean",
					"default": false,
					"markdownDescription": "%config.claudeCode.useBehavesAs.desc%"
				}
			}
		}
	},
	"main": "./out/extension.js",
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"clean": "node scripts/clean-out.mjs",
		"compile": "npm run clean && tsc -p ./",
		"watch": "tsc -watch -p ./",
		"test": "npm run compile && node scripts/test-toml-edit.mjs && node scripts/test-model-merge.mjs && node scripts/test-model-routing.mjs && node scripts/test-claude-settings.mjs && node scripts/test-catalog.mjs && node scripts/test-model-center-data.mjs && node scripts/test-go-usage.mjs && node scripts/test-usage-stats.mjs && node --check resources/usage-dashboard/dashboard.js && node --check resources/model-center/model-center.js && node scripts/test-proxy-chat.mjs && node scripts/test-proxy-anthropic.mjs && node scripts/test-proxy-messages.mjs",
		"test:e2e": "npm run compile && node scripts/test-codex-e2e.mjs",
		"test:live": "npm run compile && node scripts/test-codex-live.mjs",
		"test:binding": "node scripts/test-thinking-binding-live.mjs",
		"build": "npx @vscode/vsce package -o extension.vsix"
	},
	"devDependencies": {
		"@types/node": "^22",
		"@types/vscode": "^1.116.0",
		"@vscode/vsce": "^4.0.0",
		"typescript": "^5.9.2"
	}
}
